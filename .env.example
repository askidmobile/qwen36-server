# ==============================================================================
# Yttri Self-Inference Server Configuration (.env)
# ==============================================================================

# === 1. Авторизация и сеть ===
# JSON-массив авторизованных API-ключей [{key, name}]
API_KEYS='[{"key":"your-secret-api-key-here","name":"primary-client"}]'
# IP-адрес для прослушивания (0.0.0.0 — доступен в локальной сети)
HOST=0.0.0.0
# Порт сервера
PORT=18099

# === 2. Модель и сканирование ===
# Путь к стартовому файлу GGUF-модели
MODEL=D:\Models\deepreinforce-ai\Ornith-1.5-9B-GGUF\Ornith-1.5-9B-Q4_K_M.gguf
# Корневая папка с локальными моделями для сканирования и авто-переключения
MODELS_DIR=D:\Models

# === 3. Контекст и производительность ===
# Размер контекстного окна в токенах (131072 = 128K)
CTX=131072
# Количество параллельных непрерывных слотов инференса (1..4)
SLOTS=4
# Максимальное число генерируемых токенов по умолчанию
MAX_TOKENS=32768
# Batch size для prefill (сколько токенов обрабатывается за один проход)
BATCH_SIZE=2048
# Количество CPU потоков (по умолчанию = количество ядер)
# THREADS=8
# Строгий GPU-only режим: model tensors, embeddings и KV cache только на CUDA.
# Если модель не помещается в VRAM, загрузка завершается ошибкой без CPU fallback.
GPU_ONLY=1
# Количество слоёв модели на GPU (GPU_ONLY=1 требует 999)
GPU_LAYERS=999
# Тип KV-кэша: q8_f16 (по умолчанию, компактный), f16 (точный)
KV_CACHE_TYPE=q8_f16
# Paged/graph-prefill: KV пишется прямо в страничный пул — декод ~3x и меньше VRAM.
# «Порча состояния», из-за которой его выключали, оказалась дефектом токенизатора
# (починен); при off ещё и ломался prefix cache на int8-пуле (починен).
PGRAPH=on
# Включение Flash Attention (1 = вкл, 0 = выкл)
FLASH_ATTN=1
# Memory-mapped загрузка весов (1 = вкл, 0 = выкл)
MMAP=1
# Включение спекулятивного декодинга MTP (0 = выкл, 1 = вкл)
MTP=0
# Максимальная длина очереди запросов
MAX_QUEUE=64
# Таймаут запроса в секундах
REQ_TIMEOUT=600

# === 4. RoPE (позиционное кодирование) ===
# Масштаб RoPE (1.0 = по умолчанию)
ROPE_SCALE=1.0
# Тип масштабирования RoPE (none, yarn, linear)
ROPE_SCALE_TYPE=none

# === 5. Политика переполнения контекста ===
# error — HTTP 400 context_length_exceeded (по умолчанию; агент сожмёт историю)
# sliding_window — совместимый режим с молчаливой обрезкой старых сообщений
CTX_OVERFLOW=error

# === 6. Серверная политика сэмплинга ===
# 1 — клиентские sampling-поля игнорируются; 0 — клиент может их переопределять.
SAMPLING_LOCK=1
# Переменные ниже оставьте незаданными, чтобы использовать рекомендации
# model card активного семейства. Любое заданное значение перекрывает пресет.
# TEMPERATURE=1.0
# TOP_P=0.95
# TOP_K=20
# MIN_P=0.0
# PRESENCE_PENALTY=1.5
# REPETITION_PENALTY=1.0
# Штраф за частоту (0.0 = выкл)
FREQUENCY_PENALTY=0.0
# Seed для воспроизводимости (0 = случайный)
SEED=0
# Режим рассуждений по умолчанию (не переключает sampling-профиль по effort)
THINKING=true
# Необязательно: пользовательские пресеты, изолированные по семействам.
# Обычно заполняется WebUI через «Сохранить как пресет режима».
# MODEL_PRESETS={"gemma-4":{"instruct":{"temperature":1.0,"top_p":0.95,"top_k":64,"min_p":0.0,"presence_penalty":0.0,"repetition_penalty":1.0}}}

# === 6b. Выгрузка экспертов MoE (план 2026-09-04-moe-expert-offload) ===
# Размещение маршрутизируемых экспертов: vram | ram | auto (default).
# auto кладёт эксперты в pinned RAM, когда ствол+эксперты не помещаются в
# свободную VRAM (35B-A3B на 12 ГБ → окно 131072 вместо 20480).
# Требование к RAM при ram: свободной ≥ эксперты + PREFIX_CACHE_MIB + 2 ГиБ
# (pinned не свопится; на стенде ≈29 ГБ из 64).
#MOE_EXPERTS=auto
# Кэш горячих экспертов в VRAM (МиБ; пусто = вся VRAM после весов, пула и
# стейджинга минус резервы). Вводится фазой 4 того же плана.
#EXPERT_CACHE_MIB=
# Подъёмов экспертов из RAM в VRAM-кэш за шаг декода (default 64, фаза 4).
#EXPERT_PROMOTE_PER_STEP=64
# При выгрузке графовый префил (PGRAPH) выключается автоматически с WARN —
# префил идёт пейджед-прогревом (KV сразу в пул), графы декода сохраняются.

# === 7. Unsloth Studio (WebUI) ===
# URL Python-бэкенда Unsloth Studio. Руст-сервер проксирует все запросы
# кроме /v1/* на этот адрес. Если Studio недоступен — fallback на web/index.html.
# Запуск Studio: unsloth studio -H 127.0.0.1 -p 8888
STUDIO_URL=http://127.0.0.1:8888

# ── Итоги 2026-09-16 (Ornith-1.5-9B, RTX 3060 12 ГБ) ────────────────────────
# QWEN36_FA_PREFILL_TILE=6 — префильное FA2 на fp16-аккумуляторе: ядро
#   hdim=256 causal на 1.56x быстрее (38.9 против 24.9 TFLOPS), перплексия не
#   меняется; откат =1 (fp32-аккумулятор). См. docs/research/2026-09-16-*.
# PREFIX_CACHE_CHECKPOINTS=0 — не снимать/не восстанавливать состояние DeltaNet
#   на границах чанков: −0.28 с на префиле 30k, кеш на конце промпта работает.
# PREFIX_CACHE_MIB=2048 — 8 ГиБ на 12-гигабайтной карте приводят к свопу WDDM
#   после нескольких длинных промптов (префил 30k раздувается с 20 до 36 с);
#   2 ГиБ хватает на два-три входа по ~562 МиБ.
PREFIX_CACHE_MIB=2048
PREFIX_CACHE_CHECKPOINTS=0
# Запись во всю длину промпта вместе с логитами последней позиции: попадание
# «ровно в длину» не требует ни одного токена prefill'а (замер 2026-09-17:
# повторный 30k-запрос 0.42 с против 0.94 с при граничном снимке 30208).
# ВНИМАНИЕ: полная запись даёт мгновенный повтор (0.42 с против 0.94 с), но
# стоит +150 мс на КАЖДОМ холодном префиле (замер §79.2, три пары). В проде
# выключено — холодный профиль важнее.
PREFIX_CACHE_FULL_HIT=0
# Хвост-сплит оставляем ВКЛЮЧЁННЫМ и вместе с FULL_HIT: в кеш ложатся две
# записи — граница 30208 (нужна следующему ходу диалога: клиент склеивает
# текст и токенизирует заново, BPE съедает несколько токенов на стыке, поэтому
# запись во всю длину у следующего хода уже не префикс) и вся длина 30232 с
# логитами (мгновенное попадание повторного запроса). При TAIL_SPLIT=0
# граничный снимок не снимается вовсе — он был бы бесполезен.
PREFIX_CACHE_TAIL_SPLIT=1
QWEN36_FA_PREFILL_TILE=6
