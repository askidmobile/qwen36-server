# Copy to .env and replace keys/model paths. Never commit .env.
# JSON must stay on one line. name is an operator label; key is Bearer token.
QWEN36_API_KEYS='[{"key":"replace-with-random-key","name":"test"},{"key":"replace-with-another-random-key","name":"backup"}]'

# Validated profile/current pointer. Omit for legacy text-only QWEN36_MODEL mode.
# QWEN36_PROFILE=/absolute/path/to/qwen3.5-4b/current
QWEN36_MODEL=/absolute/path/to/model.gguf
QWEN36_MODELS_DIR=/absolute/path/to/models
QWEN36_HOST=0.0.0.0
QWEN36_PORT=8080
QWEN36_CTX=8192
QWEN36_SLOTS=4
QWEN36_PREFIX_CACHE_MIB=0

# Optional diagnostics/tuning:
# QWEN36_TRACE=0
# QWEN36_REQ_TIMEOUT=600
# QWEN36_MAX_QUEUE=64
# QWEN36_MOE_BACKEND=reference  # diagnostic rollback; omit for CUDA PTX auto-selection
# QWEN36_PREFILL_CHUNK=256
