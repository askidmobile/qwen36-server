+/// `DS41_ENGRAM_READ_THREADS`: worker threads for one engram round. The
+/// serial path the port inherited issues one pread per 264-byte row, so a
+/// 64-row decode round costs 64 disk latencies; the same rows in flight cost
+/// roughly one. Defaults to 16 (the measured knee on the Spark's NVMe: 1
+/// thread 29.6 ms, 16 threads 3.65 ms for 288 reads). 0 or 1 restores the
+/// serial path.
+fn engram_read_threads() -> usize {
+    static N: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *N.get_or_init(|| {
+        std::env::var("DS41_ENGRAM_READ_THREADS")
+            .ok()
+            .and_then(|v| v.parse::<usize>().ok())
+            .unwrap_or(16)
+    })
+}
+
+/// `DS41_ADMIT_X1024`: the serving admission's multiplier over the prefill's
+/// peak, in thousandths (default 2048 = the engine's 2x). The prefill refuses
+/// when MemAvailable is below `mult/1024 * peak`.
+fn admit_multiplier() -> u64 {
+    static M: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *M.get_or_init(|| {
+        std::env::var("DS41_ADMIT_X1024")
+            .ok()
+            .and_then(|v| v.parse::<u64>().ok())
+            .filter(|&v| v >= 1024)
+            .unwrap_or(2048)
+    })
+}
+
 fn setup_cache_on() -> bool {
