+/// One read the parallel row reader must issue: `len` bytes at `off`
+/// straight into the caller's pinned slot at `dst`.
+#[derive(Clone, Copy)]
+pub struct Span {
+    pub off: u64,
+    pub len: u32,
+    pub dst: usize,
+}
+
+impl EngramShard {
+    /// Issue every span through at most `threads` scoped worker threads. The
+    /// serial chain this replaces costs one disk latency per 264-byte row
+    /// (~100 us on the Spark's NVMe); the same reads in flight cost about one
+    /// disk latency for the whole round.
+    ///
+    /// O_DIRECT preserves the engine's bounce-buffer contract: each worker
+    /// owns one aligned bounce and copies the requested span out. Buffered
+    /// shards (the fallback open) read straight into the destination.
+    pub fn read_spans(&self, spans: &[Span], threads: usize) -> Result<(), EngramError> {
+        if spans.is_empty() {
+            return Ok(());
+        }
+        let threads = threads.max(1).min(spans.len());
+        let chunk = spans.len().div_ceil(threads);
+        let direct = self.dio;
+        let file = &self.file;
+        let mut first_err: Option<String> = None;
+        std::thread::scope(|scope| {
+            let mut handles = Vec::with_capacity(threads);
+            for t in 0..threads {
+                let lo = t * chunk;
+                if lo >= spans.len() {
+                    break;
+                }
+                let hi = (lo + chunk).min(spans.len());
+                let part = &spans[lo..hi];
+                handles.push(scope.spawn(move || -> Result<(), EngramError> {
+                    let mut bounce = if direct {
+                        Some(
+                            Bounce::new(EDIO_ALIGN * 2)
+                                .ok_or_else(|| EngramError::Io("bounce alloc".into()))?,
+                        )
+                    } else {
+                        None
+                    };
+                    for sp in part {
+                        if let Some(b) = bounce.as_mut() {
+                            let a = sp.off & !(EDIO_ALIGN as u64 - 1);
+                            let need = (sp.off - a) as usize + sp.len as usize;
+                            let nb = need.div_ceil(EDIO_ALIGN) * EDIO_ALIGN;
+                            if nb > b.len {
+                                *b = Bounce::new(nb)
+                                    .ok_or_else(|| EngramError::Io("bounce alloc".into()))?;
+                            }
+                            let buf = b.as_mut_slice();
+                            file.read_exact_at(&mut buf[..nb], a)
+                                .map_err(|e| EngramError::Io(e.to_string()))?;
+                            unsafe {
+                                std::ptr::copy_nonoverlapping(
+                                    buf.as_ptr().add((sp.off - a) as usize),
+                                    sp.dst as *mut u8,
+                                    sp.len as usize,
+                                );
+                            }
+                        } else {
+                            let dst = unsafe {
+                                std::slice::from_raw_parts_mut(sp.dst as *mut u8, sp.len as usize)
+                            };
+                            file.read_exact_at(dst, sp.off)
+                                .map_err(|e| EngramError::Io(e.to_string()))?;
+                        }
+                    }
+                    Ok(())
+                }));
+            }
+            for h in handles {
+                match h.join() {
+                    Ok(Ok(())) => {}
+                    Ok(Err(e)) => {
+                        if first_err.is_none() {
+                            first_err = Some(e.to_string());
+                        }
+                    }
+                    Err(_) => {
+                        if first_err.is_none() {
+                            first_err = Some("engram reader panicked".into());
+                        }
+                    }
+                }
+            }
+        });
+        match first_err {
+            Some(e) => Err(EngramError::Io(e)),
+            None => Ok(()),
+        }
+    }
+}
+
+
