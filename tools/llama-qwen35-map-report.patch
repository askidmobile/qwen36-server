+    def _record_map_output(self, source_name: str, output_name: str, operation: str, data: np.ndarray, data_qtype: gguf.GGMLQuantizationType) -> None:
+        if self._map_report_path is None:
+            return
+        prior = self._map_report_outputs.get(output_name)
+        if prior is not None:
+            raise ValueError(f"duplicate physical output tensor {output_name!r}: {prior!r} and {source_name!r}")
+        self._map_report_outputs[output_name] = source_name
+        self._map_report_rows.append({
+            "source": source_name,
+            "output": output_name,
+            "operation": operation,
+            "shape": "x".join(map(str, data.shape)),
+            "dtype": data_qtype.name,
+        })
 
+    def _write_map_report(self) -> None:
+        if self._map_report_path is None:
+            return
+        self._map_report_path.parent.mkdir(parents=True, exist_ok=True)
+        with open(self._map_report_path, "w", newline="", encoding="utf-8") as handle:
+            writer = csv.DictWriter(handle, fieldnames=("source", "output", "operation", "shape", "dtype"))
+            writer.writeheader()
+            writer.writerows(self._map_report_rows)
+
